<% layout('layouts/boilerplate') %>

<div class="form-container">
  <h2>Create a New Listing</h2>
  <form method="POST" action="/listings">
    <div class="form-group">
      <label>Title</label>
      <input name="listing[title]" placeholder="Enter title" type="text" required />
    </div>
    <div class="form-group">
      <label>Description</label>
      <textarea name="listing[description]" placeholder="Enter description"></textarea>
    </div>
    <div class="form-group">
      <label>Image URL</label>
      <input name="listing[image]" placeholder="Enter image URL" type="url" />
    </div>
    <div class="form-group">
      <label>Price (per night)</label>
      <input name="listing[price]" placeholder="Enter price" type="number" />
    </div>
    <div class="form-group">
      <label>Country</label>
      <input name="listing[country]" placeholder="Enter country" type="text" />
    </div>
    <div class="form-group">
      <label>Location</label>
      <input name="listing[location]" placeholder="Enter location" type="text" />
    </div>
    <div class="form-actions">
      <button class="btn-primary">Add Listing</button>
      <a href="/listings" class="btn-secondary">Cancel</a>
    </div>
  </form>
</div>
