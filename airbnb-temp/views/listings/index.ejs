<% layout('layouts/boilerplate') %>

<div class="page-header">
  <h2>All Listings</h2>
  <a href="/listings/new" class="btn-primary">+ New Listing</a>
</div>

<div class="listings-grid">
  <% for (let listing of allListings) { %>
  <a href="/listings/<%= listing._id %>" class="listing-card">
    <img src="<%= listing.image.url %>" alt="<%= listing.title %>" />
    <div class="card-body">
      <h3><%= listing.title %></h3>
      <p class="location">📍 <%= listing.location %>, <%= listing.country %></p>
      <p class="price">₹<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night</p>
    </div>
  </a>
  <% } %>
</div>
